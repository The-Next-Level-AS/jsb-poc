# Copy to backend/.env; keep the real key only in server-side environment variables.
# The placeholder permits deployment, but search returns 503 until configured.
OPENAI_API_KEY=UNCONFIGURED
# Allow the existing GitHub Pages origin.
# For development, explicitly add origins, for example:
# ALLOWED_ORIGINS=https://the-next-level-as.github.io,http://localhost:8000
ALLOWED_ORIGINS=https://the-next-level-as.github.io
